@inherits LayoutComponentBase
@inject ISettingsService SettingsService

<div class="app-root @(_darkMode ? "" : "light-theme")">
    <CricketScoreboardApp.Components.Shared.ToastComponent />

    <main class="app-main">
        @Body
    </main>

    <nav class="navbar-bottom" aria-label="Main navigation">
        <NavLink href="/" class="nav-item" Match="NavLinkMatch.All">
            <span class="nav-icon">🏠</span>
            <span>Home</span>
        </NavLink>
        <NavLink href="/newmatch" class="nav-item">
            <span class="nav-icon">🏏</span>
            <span>New</span>
        </NavLink>
        <NavLink href="/livematch" class="nav-item">
            <span class="nav-icon">🔴</span>
            <span>Live</span>
        </NavLink>
        <NavLink href="/history" class="nav-item">
            <span class="nav-icon">📋</span>
            <span>History</span>
        </NavLink>
        <NavLink href="/teams" class="nav-item">
            <span class="nav-icon">👥</span>
            <span>Teams</span>
        </NavLink>
        <NavLink href="/players" class="nav-item">
            <span class="nav-icon">🧑</span>
            <span>Players</span>
        </NavLink>
        <NavLink href="/records" class="nav-item">
            <span class="nav-icon">🏆</span>
            <span>Records</span>
        </NavLink>
        <NavLink href="/settings" class="nav-item">
            <span class="nav-icon">⚙️</span>
            <span>Settings</span>
        </NavLink>
    </nav>
</div>

@code {
    private bool _darkMode = true;

    protected override async Task OnInitializedAsync()
    {
        var settings = await SettingsService.GetSettingsAsync();
        _darkMode = settings.DarkMode;
    }
}
