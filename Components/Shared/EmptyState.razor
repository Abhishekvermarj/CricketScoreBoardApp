<div class="empty-state">
    <div class="emoji">@Emoji</div>
    <h3>@Title</h3>
    <p>@Message</p>
    @if (ShowAction)
    {
        <button class="btn btn-primary" @onclick="HandleAction">@ActionText</button>
    }
</div>

@code {
    [Parameter] public string Emoji { get; set; } = "📭";
    [Parameter] public string Title { get; set; } = "Nothing here yet";
    [Parameter] public string Message { get; set; } = "Get started by adding something.";
    [Parameter] public bool ShowAction { get; set; }
    [Parameter] public string ActionText { get; set; } = "Get Started";
    [Parameter] public EventCallback OnAction { get; set; }

    private async Task HandleAction() => await OnAction.InvokeAsync();
}